{
  "name": "@ardrive/turbo-zora-uploader",
  "version": "0.1.0",
  "description": "An Uploader for the Zora Coins SDK that stores coin metadata and media on Arweave through Turbo: free signed uploads from an EVM wallet, or x402 uploads paid in USDC on Base.",
  "keywords": [
    "zora",
    "coins",
    "uploader",
    "arweave",
    "turbo",
    "ardrive",
    "base",
    "x402",
    "usdc",
    "metadata"
  ],
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "examples/",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "types": "tsc -p test/types/tsconfig.json",
    "live:testnet": "node scripts/live-testnet.js",
    "live:mainnet-free": "node scripts/live-mainnet-free.js"
  },
  "dependencies": {
    "@ardrive/turbo-upload": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@zoralabs/coins-sdk": "0.8.0",
    "typescript": "7.0.2",
    "viem": "2.53.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Permanent Data Solutions, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardriveapp/turbo-zora-uploader.git"
  },
  "homepage": "https://github.com/ardriveapp/turbo-zora-uploader#readme",
  "bugs": {
    "url": "https://github.com/ardriveapp/turbo-zora-uploader/issues"
  }
}
